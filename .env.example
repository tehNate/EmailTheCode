# CoCoMail environment example.
# Copy to .env for local development. Never commit the real file.
COCOMAIL_API_KEY=change-me-to-a-long-random-token
COCOMAIL_HOST=127.0.0.1
COCOMAIL_PORT=3100
COCOMAIL_LOG_FILE=./cocomail.jsonl
COCOMAIL_ALLOWED_FROM_DOMAINS=example.com

# Optional SMTP relay. Leave blank to use local sendmail/Postfix.
# COCOMAIL_SMTP_HOST=smtp.example.com
# COCOMAIL_SMTP_PORT=587
# COCOMAIL_SMTP_USER=mailer
# COCOMAIL_SMTP_PASS=change-me
