# EmailTheCode environment example.
# Copy to .env for local development. Never commit the real file.
EMAILTHECODE_API_KEY=change-me-to-a-long-random-token
EMAILTHECODE_HOST=127.0.0.1
EMAILTHECODE_PORT=3100
EMAILTHECODE_LOG_FILE=./emailthecode.jsonl
EMAILTHECODE_ALLOWED_FROM_DOMAINS=example.com

# Optional SMTP relay. Leave blank to use local sendmail/Postfix.
# EMAILTHECODE_SMTP_HOST=smtp.example.com
# EMAILTHECODE_SMTP_PORT=587
# EMAILTHECODE_SMTP_USER=mailer
# EMAILTHECODE_SMTP_PASS=change-me
